# ---------------------------------------------------------------------------
# XAMANEK — variables de entorno. Copia a .env y completa los valores.
# Nunca subas .env al repositorio (ya está en .gitignore y .dockerignore).
# ---------------------------------------------------------------------------

# Dominio público (sin https://). Caddy emite el certificado para este dominio y www.
DOMAIN=xamanek.com

# Correo para avisos de Let's Encrypt (vencimientos de certificados).
ACME_EMAIL=admin@xamanek.com

# URL canónica del sitio (con https://, sin / final). Se usa en metadata, sitemap y hreflang.
# Se incrusta en el build: si la cambias, reconstruye (docker compose up -d --build).
NEXT_PUBLIC_SITE_URL=https://xamanek.com

# WhatsApp en formato internacional, solo dígitos (wa.me). Ej. MX: 5215512345678
# TODO: número real. Se incrusta en el build.
NEXT_PUBLIC_WHATSAPP_NUMBER=5215500000000

# TODO(CRM): conexión al CRM de Odoo para /api/lead (aún no implementada).
# ODOO_URL=https://tu-instancia.odoo.com
# ODOO_DB=tu-base
# ODOO_USER=api@xamanek.com
# ODOO_API_KEY=
